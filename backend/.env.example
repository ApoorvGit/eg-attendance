# DIRECT (non-pooled) Neon connection -- the hostname must NOT contain `-pooler`.
# The pooler breaks `prisma migrate deploy` (P1002: cannot hold a session advisory lock) and
# buys nothing here, since this is a persistent process with its own Prisma connection pool.
DATABASE_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

APP_SECRET="replace-with-a-long-random-string"
FRONTEND_ORIGIN="http://localhost:3000"
PORT=4000

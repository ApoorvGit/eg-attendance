# Pooled connection -- used for the app's runtime queries.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Direct (NON-pooled) connection to the same database -- used only by Prisma Migrate.
# Same string as above with `-pooler` removed from the hostname. Required: migrations take a
# session-level advisory lock that a transaction-mode pooler cannot hold (fails with P1002),
# and `prisma generate` errors if this is unset.
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

APP_SECRET="replace-with-a-long-random-string"
FRONTEND_ORIGIN="http://localhost:3000"
PORT=4000

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Must be a DIRECT (non-pooled) connection -- no `-pooler` in the hostname.
  //
  // This backend is a long-lived Node process and Prisma maintains its own connection pool,
  // so Neon's PgBouncer adds nothing. It actively breaks migrations: `migrate deploy` takes a
  // session-level pg_advisory_lock, and a transaction-mode pooler gives each transaction a
  // different backend connection, so the lock can never be held (fails with P1002 after 10s).
  // If this app ever moves to a serverless host, reintroduce the pooled URL here and add
  // `directUrl` for migrations.
  url      = env("DATABASE_URL")
}

model AttendanceDay {
  date      String   @id // ISO date, e.g. "2026-09-08"
  status    String   // "OFFICE" | "ABSENT"
  updatedAt DateTime @updatedAt

  @@map("attendance_day")
}

model BlockedDate {
  date      String   @id // future ISO date the user cannot attend
  reason    String?
  createdAt DateTime @default(now())

  @@map("blocked_date")
}

model Holiday {
  date String  @id // ISO date, non-working regardless of weekday
  name String?

  @@map("holiday")
}

// Singleton row (id always 1) holding the few policy/config knobs that aren't raw dates.
model Settings {
  id                  Int     @id @default(1)
  employmentStartDate String? // ISO date; weeks before this are excluded from the window
  safetyBufferDays    Int     @default(2)
  workDays            String  @default("1,2,3,4,5") // 0=Sun..6=Sat

  @@map("settings")
}
